# Kopieren nach .env und Werte anpassen. Die Datei .env wird nicht ins Git übernommen.

# Datenbankdatei (relativ zum Ordner prisma/)
DATABASE_URL="file:../data/app.db"

# Langer Zufallswert zum Signieren der Anmeldung (mind. 32 Zeichen)
SESSION_SECRET="bitte-durch-langen-zufallswert-ersetzen"

# Erster Admin – wird von `npx prisma db seed` angelegt
ADMIN_NAME="Luis"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORT="bitte-aendern"

# Auf "true" setzen, sobald die App über HTTPS läuft
COOKIE_SECURE="false"
